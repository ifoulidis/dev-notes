---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPosts } from '@/lib/posts';

const posts = await getPosts();
---

<BaseLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="text-4xl font-bold">Latest notes</h1>
    {posts.length === 0 && <p class="mt-6 text-neutral-500">Nothing here yet. Write something at /keystatic.</p>}
    <ul class="mt-8 space-y-6">
      {
        posts.map(({ id, data, readingTime }) => (
          <li>
            <a
              href={`/posts/${id}`}
              class="block rounded-lg border-2 border-transparent bg-neutral-50 p-5 shadow-sm transition-[scale,border-color] hover:scale-[1.02] hover:border-accent active:scale-[0.98] dark:bg-neutral-900"
            >
              <h2 class="text-2xl font-bold">
                {data.title}
                {data.draft && <span class="ml-2 align-middle text-sm font-normal text-neutral-500">(draft)</span>}
              </h2>
              <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {readingTime}
              </p>
              {data.description !== '' && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{data.description}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
