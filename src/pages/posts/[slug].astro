---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import { mdxComponents } from '@/components/mdx';
import { formatDate, getPosts } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { title, description, date, cover } = post.data;
const { Content, headings } = await render(post);

/** Article typography, on top of the typography plugin's spacing. */
const prose = [
  'scroll-reveal prose mx-auto text-base sm:text-article-body dark:prose-invert',
  'prose-p:leading-relaxed prose-p:text-neutral-600 prose-li:leading-relaxed prose-li:text-neutral-600',
  'dark:prose-p:text-neutral-100 dark:prose-li:text-neutral-100',
  // Accent links: deepened on light backgrounds so they stay readable.
  'prose-a:font-normal prose-a:text-accent-deep prose-a:no-underline prose-a:hover:text-accent',
  'dark:prose-a:text-accent dark:prose-a:hover:text-accent-soft',
  // Headings sit close to the text they introduce.
  'prose-headings:mb-2 prose-headings:leading-heading dark:prose-headings:text-white [&_h1+*]:mt-0',
  'prose-h1:mt-8 prose-h1:text-2xl prose-h1:font-bold prose-h1:uppercase sm:prose-h1:text-article-h1',
  // Subheadings step in from the heading above them, so one directly under another reads as part of it.
  // h2s need their own dark colour: `prose-h2:` is emitted after `dark:prose-headings:`, so its grey would win.
  'prose-h2:mt-6 prose-h2:pl-4 prose-h2:text-xl prose-h2:text-neutral-600 dark:prose-h2:text-white sm:prose-h2:text-article-h2',
  'prose-h3:mt-4 prose-h3:pl-8 prose-h3:text-article-h3 prose-h3:font-normal prose-h3:underline',
  // Quotes are indented with an accent bar beside them, in plain darker text.
  'prose-blockquote:mx-4 prose-blockquote:my-4 prose-blockquote:border-l-[5px] prose-blockquote:border-accent',
  'prose-blockquote:pl-4 prose-blockquote:font-normal prose-blockquote:not-italic sm:prose-blockquote:mx-10',
  // Targets the quote's paragraphs directly, to beat the grey given to every paragraph above.
  '[&_blockquote>p]:my-0 [&_blockquote>p]:text-neutral-900 dark:[&_blockquote>p]:text-white',
];
---

<BaseLayout title={title} description={description}>
  <ProgressBar />
  <article class="mx-auto max-w-4xl px-4 py-8 font-book">
    <header class="mb-6">
      {
        cover != null && (
          <Image
            src={cover}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(max-width: 896px) 100vw, 896px"
            loading="eager"
            fetchpriority="high"
            class="mb-6 aspect-video w-full rounded-lg object-cover"
          />
        )
      }
      <h1 class="text-3xl leading-heading font-bold sm:text-article-title">{title}</h1>
      {description !== '' && <p class="mt-3 text-xl text-neutral-600 dark:text-neutral-100">{description}</p>}
      <div class="mt-4 flex items-center justify-between text-neutral-500 dark:text-neutral-400">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <p>{post.readingTime}</p>
      </div>
      <hr class="mt-4 border-neutral-300 dark:border-neutral-600" />
    </header>

    <TableOfContents headings={headings} />

    <div class:list={prose}>
      <Content components={mdxComponents} />
    </div>
  </article>
</BaseLayout>
